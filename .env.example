# Neon Postgres (pooled connection string). Leave empty locally to use the in-memory dev store.
DATABASE_URL=
# Ably API key (server only). Leave empty locally to use the built-in dev stream instead of Ably.
ABLY_API_KEY=
# Long random string used to sign guest session cookies (required in production).
SESSION_SECRET=
# Secret Vercel sends to the daily cleanup cron (required in production).
CRON_SECRET=
